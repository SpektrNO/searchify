{
  "mcpServers": {
    "searchify": {
      "command": "/home/fsat/dev/spektr/searchify/bin/searchify",
      "args": ["mcp", "stdio"],
      "env": {
        "SEARCHIFY_ROOTS": "/home/fsat/dev",
        "SEARCHIFY_INDEX_DIR": "",
        "SEARCHIFY_EMBED_MODEL": "minilm-l6-v2",
        "LANGSEARCH_API_KEY": ""
      }
    },
    "searchify-http": {
      "url": "http://127.0.0.1:8080/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_SEARCHIFY_HTTP_TOKEN"
      }
    }
  }
}
