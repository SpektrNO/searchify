# GitHub (for scripts/* and issue tracking)
GITHUB_REPO=SpektrNO/searchify
GH_TOKEN=
# Optional PAT alias if you prefer the name GH_PAT
# GH_PAT=

# Optional: sync status/todo|in-progress|done to a GitHub Project board
# GITHUB_PROJECT_OWNER=SpektrNO
# GITHUB_PROJECT_NUMBER=
# GITHUB_PROJECT_STATUS_FIELD=Status
# GITHUB_PROJECT_STATUS_TODO=Todo
# GITHUB_PROJECT_STATUS_IN_PROGRESS=In Progress
# GITHUB_PROJECT_STATUS_DONE=Done

# Optional: CLI / `make run` only. Cursor MCP reads .cursor/mcp.json instead.
# SEARCHIFY_ROOTS=/home/fsat/dev
# SEARCHIFY_INDEX_DIR=
# Preferred base for relative MCP/CLI paths (must be under a root).
# Useful when Cursor passes repo-relative paths like docs/readme.md
# SEARCHIFY_PATH_BASE=/home/fsat/dev/spektr/searchify
# Optional auto-index while mcp stdio / serve http is running:
# SEARCHIFY_WATCH_PATHS=/home/fsat/dev/spektr/searchify/docs
# SEARCHIFY_WATCH_DEBOUNCE=1s
# SEARCHIFY_WATCH_RESCAN=5m
# Optional OCR for images / scanned PDFs (requires tesseract on PATH; PDF OCR needs pdftoppm):
# SEARCHIFY_OCR=0
# SEARCHIFY_OCR_LANG=eng
# SEARCHIFY_MAX_FILE_BYTES=33554432
# SEARCHIFY_EXTRACT_TIMEOUT=30s
# LANGSEARCH_API_KEY=
# SEARCHIFY_HTTP_TOKEN=
# SEARCHIFY_HTTP_ADDR=:8080
# SEARCHIFY_EMBED_MODEL=minilm-l6-v2
